{
  "name": "music-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "check:architecture": "node scripts/architecture.mjs",
    "check:budget": "next build && node scripts/budget.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.15.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
